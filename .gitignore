# OCR helper protocol / scratch files (regenerated at runtime by ocr_server.exe)
ocr_req.txt
ocr_req.txt.tmp
ocr_resp.txt
ocr_resp.txt.tmp
ocr_ready.txt
ocr_stop.txt
ocr_capture.png
ocr_result.txt
ocr_result.txt.tmp

# Compiled OCR helper (built from ocr/ via PyInstaller; see ocr/BUILD.md). Not committed,
# same posture as remote/agent/*.exe below.
macro/ocr_server.exe

# Shadow OCR benchmark runtime output (see ocr/BUILD.md). Written into the macro's DataDir,
# which is macro/ itself on a source/dev run, so it would otherwise show up as untracked.
ocr_benchmark_spool/
ocr_benchmark_log.jsonl
ocr_benchmark_stop.txt

# Python OCR helper (ocr/) - venv, build artifacts, caches
ocr/.venv/
ocr/.venv-benchmark/
ocr/dist/
ocr/dist-benchmark/
ocr/build/
ocr/build-benchmark/
ocr/*.spec
ocr/**/__pycache__/
ocr/.pytest_cache/
ocr/*.egg-info/

# Remote bridge protocol / scratch files (regenerated at runtime by remote_bridge.ahk)
remote_status.json
remote_status.json.tmp
remote_cmd.txt
remote_cmd.txt.tmp
remote_ack.txt
remote_ack.txt.tmp

# Local bridge protocol / scratch files (regenerated at runtime by local_bridge.ahk, for the
# Python GUI; same shape as the remote bridge files above)
local_status.json
local_status.json.tmp
local_cmd.txt
local_cmd.txt.tmp
local_ack.txt
local_ack.txt.tmp
local_capture_result.txt
local_capture_result.txt.tmp
engine_ready.txt
engine_ready.txt.tmp

# Written while the fullscreen opening has the game window's title bar stripped, so a later run can
# put it back even after a crash (see ApplyBorderlessGameWindow in tower_defense_macro_gui.ahk).
game_frame_restore.txt

# Background session marker (written by gui/app/background_session.py into the data directory,
# which is macro/ itself on a source/dev run)
background_session_state.json
background_session_state.json.tmp

# Rotating config.ini backups (local safety net, not source)
config_backups/

config.ini

# Runtime log (regenerated on every run, not source)
macro_log.txt

# Codex delegation live reasoning transcripts + locks (per-model, regenerated by tools/codex-delegate.mjs)
codex-reasoning*.md
codex-reasoning*.md.lock

# Python GUI (gui/) - venv, build artifacts, caches (mirrors ocr/ above)
gui/.venv/
gui/dist/
gui/build/
gui/*.spec
gui/**/__pycache__/
gui/.pytest_cache/
gui/*.egg-info/

# Compiled AHK engine + release assets (built locally by following release.yml's own steps, e.g.
# to reproduce/verify the release build before pushing a tag) - never committed, CI's own /dist/
# is ephemeral per-run so this was never hit there.
/dist/

# generated only by release.yml inside the CI checkout, never committed
RELEASE_BUILD

# Downloaded toolchains used by the local and CI package builds
/.build/

# Remote access system (remote/) - build artifacts, dependencies, and local runtime data
remote/agent/*.exe
remote/agent/dist/
remote/server/node_modules/
remote/server/dist/
remote/server/.data/
remote/server/pgdata/
remote/**/.env
remote/**/.env.local
remote/server/*.log

# SSH key pairs (e.g. downloaded when creating the Oracle Cloud VM) - never commit private keys
*.pem
*.key
*.key.pub

# Claude Code session state (the worktrees each session creates, and machine-local settings).
# .claude/skills/ IS committed: those are project workflow definitions, not session state.
.claude/worktrees/
.claude/settings.local.json
fix-config.ps1
config_general_repaired.ini
