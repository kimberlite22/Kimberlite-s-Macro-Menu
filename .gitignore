# OCR helper protocol / scratch files (regenerated at runtime by ocr_server.exe)
ocr_req.txt
ocr_req.txt.tmp
ocr_resp.txt
ocr_resp.txt.tmp
ocr_ready.txt
ocr_stop.txt
ocr_capture.png
ocr_result.txt
ocr_result.txt.tmp

# Compiled OCR helper (built from ocr/ via PyInstaller; see ocr/BUILD.md). Not committed,
# same posture as remote/agent/*.exe below.
macro/ocr_server.exe

# Python OCR helper (ocr/) - venv, build artifacts, caches
ocr/.venv/
ocr/dist/
ocr/build/
ocr/*.spec
ocr/**/__pycache__/
ocr/.pytest_cache/
ocr/*.egg-info/

# Remote bridge protocol / scratch files (regenerated at runtime by remote_bridge.ahk)
remote_status.json
remote_status.json.tmp
remote_cmd.txt
remote_cmd.txt.tmp
remote_ack.txt
remote_ack.txt.tmp

# Rotating config.ini backups (local safety net, not source)
config_backups/

config.ini

# Codex delegation live reasoning transcripts + locks (per-model, regenerated by tools/codex-delegate.mjs)
codex-reasoning*.md
codex-reasoning*.md.lock

# Remote access system (remote/) - build artifacts, dependencies, and local runtime data
remote/agent/*.exe
remote/agent/dist/
remote/server/node_modules/
remote/server/dist/
remote/server/.data/
remote/server/pgdata/
remote/**/.env
remote/**/.env.local
remote/server/*.log

# SSH key pairs (e.g. downloaded when creating the Oracle Cloud VM) - never commit private keys
*.pem
*.key
*.key.pub