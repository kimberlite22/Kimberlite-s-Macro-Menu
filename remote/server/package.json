{
  "name": "anime-expedition-remote-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Cloud backend + web MVP for remote access to Kimberlite's Macro Menu (phone-home architecture).",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "backup": "node scripts/backup.mjs",
    "test": "node --test --import tsx"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.4",
    "@fastify/cookie": "^11.1.2",
    "@fastify/rate-limit": "^11.1.0",
    "@fastify/static": "^10.1.2",
    "better-auth": "^1.6.25",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.10.0",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.1.3",
    "tsx": "^4.23.1",
    "typescript": "~5.9.3"
  }
}
