# Anime Expedition remote backend - environment configuration.
# Copy to .env for local development (.env is gitignored). Never commit real secrets.

# --- Server ---
# Port and bind address. Keep HOST=127.0.0.1 unless a reverse proxy (Caddy / Cloudflare Tunnel)
# terminates TLS in front of the app; do not expose the app directly on 0.0.0.0 without TLS.
PORT=8787
HOST=127.0.0.1

# development | production | test. Production REQUIRES AUTH_SECRET to be set and enables secure cookies.
NODE_ENV=development

# Public origin the browser uses to reach the app (used for auth cookies / trusted origins).
# In production set this to your real https URL, e.g. https://macro.example.com
PUBLIC_URL=http://localhost:8787

# --- Auth ---
# Secret used by better-auth to sign sessions. REQUIRED in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# --- Database ---
# DEV (default): leave DATABASE_URL empty to use the embedded PGlite (pure-WASM Postgres) in DATA_DIR.
# PROD: set DATABASE_URL to a real Postgres connection string; then DATA_DIR is ignored.
# DATABASE_URL=postgres://user:pass@localhost:5432/anime_expedition
DATA_DIR=./.data

# --- Reverse proxy ---
# Set TRUST_PROXY=true ONLY when a trusted reverse proxy (Caddy / Cloudflare Tunnel) terminates in
# front of the app, so request.ip comes from X-Forwarded-For. Leaving it false when directly exposed
# prevents clients from spoofing their IP to bypass the rate limiter or falsify audit IPs.
TRUST_PROXY=false

# --- Rate limiting (app-wide, per IP; auth endpoints have their own limits) ---
RATE_LIMIT_MAX=300
RATE_LIMIT_WINDOW=1 minute

# --- Agent update hint (agents log when a newer version is published) ---
AGENT_LATEST_VERSION=0.1.0
AGENT_MIN_VERSION=0.1.0

# --- Command delivery tuning ---
# A delivered-but-unacked command may be redelivered after the lease, and is expired after max-age.
COMMAND_LEASE_SECONDS=30
COMMAND_MAX_AGE_SECONDS=300

# --- Tuning ---
COMMAND_LONGPOLL_DEFAULT_SECONDS=25
COMMAND_LONGPOLL_MAX_SECONDS=55
PAIRING_CODE_TTL_MINUTES=10
LOG_MAX_PER_DEVICE=5000

# --- Backups (scripts/backup.mjs) ---
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
